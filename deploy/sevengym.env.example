# /etc/sevengym.env — the server's secrets. Copy, fill in, then: chmod 600 /etc/sevengym.env
# The same OWNER_CODE and TOKEN_SECRET as on Vercel: with another TOKEN_SECRET every staff member and client is signed out.
OWNER_CODE=
TOKEN_SECRET=
PORT=3100
DIST_DIR=/srv/sevengym/app/dist
MEDIA_DIR=/srv/sevengym/media
PUBLIC_URL=https://sevengym.matai.kz
DB_REST_URL=http://127.0.0.1:3000
